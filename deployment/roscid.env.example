# roscid environment file — copy to /etc/roscid/roscid.env, fill in,
# `chmod 600`, `chown roscid:`. Every value here is a startup fact:
# roscid refuses to boot half-configured rather than failing per request.

# Bind address. 127.0.0.1 needs no API key; anything else REQUIRES
# OSCI_API_KEY (roscid exits 2 otherwise — a signing endpoint must not
# sit open on the network).
OSCI_BIND=127.0.0.1:8080
#OSCI_API_KEY=generate-with: openssl rand -hex 32

# The machine's OSCI identity: signing keystore (PKCS#12) and its PIN
# source. PIN precedence: pinfile beats OSCI_CERT_PIN; prefer the
# pinfile (a file at 0600 beats a process environment any day).
OSCI_CERT=/etc/roscid/certs/signing.p12
OSCI_PINFILE=/etc/roscid/certs/pin

# Separate decrypter keystore — required when answers are encrypted to
# a cipher certificate that differs from the signing certificate (the
# common DOI/V-PKI shape). Omit when the signing bundle already carries
# the cipher key.
#OSCI_DECRYPTER_CERT=/etc/roscid/certs/cipher.p12

# The intermediary's entry point: URL plus its cipher certificate
# (PEM or base64-DER) for the transport-encryption leg.
OSCI_INTERMEDIARY=https://mediator.example.gov/entry
OSCI_INTERMEDIARY_CERT=/etc/roscid/certs/intermediary-cipher.pem

# Extra TLS trust anchor for the intermediary connection — needed when
# the endpoint presents a certificate from a non-public PKI. NOTE:
# configured anchors REPLACE the system roots, they do not extend them.
#OSCI_TLS_CA=/etc/roscid/certs/intermediary-tls-ca.pem

# Per-operation bound in seconds. A wedged intermediary must surface as
# HTTP 504, not as a connection held open.
OSCI_RESPONSE_TIMEOUT_SECS=300

# RUST_LOG=info  # tracing filter, defaults to "info"
