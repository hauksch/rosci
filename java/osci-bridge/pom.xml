<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.rosci</groupId>
  <artifactId>osci-bridge</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>osci-bridge</name>
  <description>
    The Java sidecar that does the OSCI-Transport-1.2 heavy lifting so the Rust
    CLI doesn't have to. Speaks one JSON object per line on stdio and not a
    single word more — unlike certain specifications we could name.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Fixed jar entry timestamps: two builds from the same tree produce
         byte-identical jars (verified via make release twice). -->
    <project.build.outputTimestamp>2026-10-01T00:00:00Z</project.build.outputTimestamp>
    <maven.compiler.release>17</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>

    <!-- Warnings are findings. Findings fail the build. -->
    <maven.compiler.showWarnings>true</maven.compiler.showWarnings>
    <maven.compiler.failOnWarning>true</maven.compiler.failOnWarning>

    <!-- pinned, checksum-verified via make manifest / make verify-deps -->
    <osci.version>2.6.1</osci.version>
    <!-- bcprov (managed by the osci BOM at 1.85.2) got a hotfix bcpkix never
         received; 1.85 is the matching bcpkix for the 1.85.x line. -->
    <bc.pkix.version>1.85</bc.pkix.version>
    <gson.version>2.13.2</gson.version>
    <junit.version>6.1.3</junit.version>
    <slf4j.version>2.0.20</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Governikus' own BOM keeps osci + bouncycastle + slf4j versions coherent. -->
      <dependency>
        <groupId>de.osci</groupId>
        <artifactId>osci-bibliothek-bom</artifactId>
        <version>${osci.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>de.osci</groupId>
      <artifactId>osci-bibliothek</artifactId>
      <version>${osci.version}</version>
    </dependency>
    <!-- MessageMetaData custom SOAP header (Ergänzung; BOM-managed). -->
    <dependency>
      <groupId>de.osci</groupId>
      <artifactId>extension-message-meta-data</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>
    <!-- Library logs via slf4j-api; simple backend goes to stderr so the
         stdout line protocol stays surgically clean. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>${bc.pkix.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>osci-bridge</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Xlint:-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <!-- jar + resources are pinned explicitly to pull their transitive
           trees past published advisories (commons-io, plexus-utils, snappy):
           the super-POM defaults (3.4.1 / 3.3.1) resolve vulnerable versions
           that `make audit`'s OSV gate then flags. The plexus-utils override
           applies the same lever one level deeper: shade 3.6.2 and resources
           3.5.0 are already the newest stable releases but still carry
           plexus-utils 3.6.0 (directory traversal, fixed in 3.6.1) — a direct
           plugin dependency wins the classpath mediation over the transitive. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
        <dependencies>
          <dependency>
            <groupId>org.codehaus.plexus</groupId>
            <artifactId>plexus-utils</artifactId>
            <version>3.6.2</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <dependencies>
          <!-- jacoco ships plexus-utils 3.0.24 (directory traversal, fixed in
               3.6.1) as a direct dependency and has never bumped it — the
               plugin-level override wins the classpath mediation. -->
          <dependency>
            <groupId>org.codehaus.plexus</groupId>
            <artifactId>plexus-utils</artifactId>
            <version>3.6.2</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <dependencies>
          <!-- see the resources-plugin comment: pulls plexus-utils past
               GHSA-6fmv-xxpf-w3cw without waiting for a shade release -->
          <dependency>
            <groupId>org.codehaus.plexus</groupId>
            <artifactId>plexus-utils</artifactId>
            <version>3.6.2</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>de.rosci.osci.bridge.Bridge</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <systemPropertyVariables>
            <!-- Negative tests deliberately trip the library's crypto path
                 (decrypterFailsOnGarbageInput feeds it garbage); de.osci
                 logs the expected BadBlockException at WARN through
                 slf4j-simple, which made every `make release` look like a
                 crash report. The assertions still prove the failure mode
                 — only the expected log noise is muted. -->
            <org.slf4j.simpleLogger.log.de.osci.osci12.encryption.Crypto>off</org.slf4j.simpleLogger.log.de.osci.osci12.encryption.Crypto>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
